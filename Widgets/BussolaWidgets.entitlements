<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- O mesmo grupo da app: é por aqui que o widget lê o instantâneo do dia
         e escreve capturas sem abrir nada. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.pt.bussola.app</string>
    </array>
</dict>
</plist>
